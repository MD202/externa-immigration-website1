{
  "name": "Consultation",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "matter": {
      "type": "string",
      "enum": [
        "Appeal or refusal",
        "Family sponsorship",
        "Humanitarian and compassionate",
        "Entrepreneurship",
        "Permanent residence or PNP",
        "PR card or citizenship",
        "Other (permits & visas)",
        "Refugee claim",
        "Employer"
      ]
    },
    "urgency": {
      "type": "string",
      "enum": [
        "Deadline within 7 days",
        "Deadline within 30 days",
        "No immediate deadline",
        "Not sure"
      ]
    },
    "summary": {
      "type": "string"
    },
    "service_tier": {
      "type": "string",
      "enum": [
        "quick_question",
        "full_consultation",
        "application_review"
      ]
    },
    "preferred_date": {
      "type": "string"
    },
    "preferred_time": {
      "type": "string"
    },
    "payment_preference": {
      "type": "string",
      "enum": [
        "pay_now",
        "pay_later"
      ]
    },
    "agreement_accepted": {
      "type": "boolean"
    },
    "signature_name": {
      "type": "string"
    },
    "triage_tag": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "contacted"
      ],
      "default": "new"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}